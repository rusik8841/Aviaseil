<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AirlinesApp.Views.FleetPage"
             Title="Самолёты">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">
            <Button Text="Обновить" Clicked="OnLoadClicked" />

            <CollectionView x:Name="ItemsList" SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="5" Margin="0,2" Stroke="Gray">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding tail_number, StringFormat='Борт {0}'}" FontAttributes="Bold" />
                                <Label Text="{Binding model}" />
                                <Label Text="{Binding is_ready_for_flight, StringFormat='Готов: {0}'}" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="2" Color="Gray" />
            <Label Text="Добавить / Редактировать:" FontAttributes="Bold" />

            <Entry x:Name="EntTail" Placeholder="Бортовой номер" Keyboard="Numeric" />
            <Entry x:Name="EntModel" Placeholder="Модель" />
            <Label Text="Дата изготовления:" />
            <DatePicker x:Name="EntMfgDate" />
            <Label Text="Срок эксплуатации:" />
            <DatePicker x:Name="EntOpLife" />
            <HorizontalStackLayout Spacing="5">
                <Label Text="Готов к вылету:" VerticalOptions="Center" />
                <Switch x:Name="SwReady" />
            </HorizontalStackLayout>
            <Entry x:Name="EntCmdId" Placeholder="ID командира" Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Сохранить" Clicked="OnSaveClicked" BackgroundColor="Green" TextColor="White" />
                <Button Text="Удалить" Clicked="OnDeleteClicked" BackgroundColor="Red" TextColor="White" />
                <Button Text="Очистить" Clicked="OnClearClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>