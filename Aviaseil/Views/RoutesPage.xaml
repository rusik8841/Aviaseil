<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AirlinesApp.Views.RoutesPage"
             Title="Маршруты">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">
            <Button Text="Обновить" Clicked="OnLoadClicked" />

            <CollectionView x:Name="ItemsList" SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="5" Margin="0,2" Stroke="Gray">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding route_number}" FontAttributes="Bold" />
                                <Label Text="{Binding departure_airport}" />
                                <Label Text="→" />
                                <Label Text="{Binding arrival_airport}" />
                                <Label Text="{Binding ticket_price, StringFormat='{0}₽'}" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="2" Color="Gray" />
            <Label Text="Добавить / Редактировать:" FontAttributes="Bold" />

            <Entry x:Name="EntNum" Placeholder="Номер маршрута" Keyboard="Numeric" />
            <Entry x:Name="EntDep" Placeholder="Аэропорт вылета" />
            <Entry x:Name="EntArr" Placeholder="Аэропорт назначения" />
            <Entry x:Name="EntPrice" Placeholder="Цена билета" Keyboard="Numeric" />
            <Entry x:Name="EntDur" Placeholder="Время в пути (мин)" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Сохранить" Clicked="OnSaveClicked" BackgroundColor="Green" TextColor="White" />
                <Button Text="Удалить" Clicked="OnDeleteClicked" BackgroundColor="Red" TextColor="White" />
                <Button Text="Очистить" Clicked="OnClearClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>