<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AirlinesApp.Views.PassengersPage"
             Title="Пассажиры">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">
            <Button Text="Обновить" Clicked="OnLoadClicked" />

            <CollectionView x:Name="ItemsList" SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="5" Margin="0,2" Stroke="Gray">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding passport_number}" FontAttributes="Bold" />
                                <Label Text="{Binding full_name}" />
                                <Label Text="{Binding phone}" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="2" Color="Gray" />
            <Label Text="Добавить / Редактировать:" FontAttributes="Bold" />

            <Entry x:Name="EntPassport" Placeholder="Номер паспорта" Keyboard="Numeric" />
            <Entry x:Name="EntName" Placeholder="ФИО" />
            <Entry x:Name="EntAddress" Placeholder="Адрес" />
            <Entry x:Name="EntPhone" Placeholder="Телефон" Keyboard="Telephone" />
            <Entry x:Name="EntEmail" Placeholder="Email" Keyboard="Email" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Сохранить" Clicked="OnSaveClicked" BackgroundColor="Green" TextColor="White" />
                <Button Text="Удалить" Clicked="OnDeleteClicked" BackgroundColor="Red" TextColor="White" />
                <Button Text="Очистить" Clicked="OnClearClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>